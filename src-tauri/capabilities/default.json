{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The launcher's window: its own commands, moving and closing the frameless window, the folder picker, links, its own update",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
